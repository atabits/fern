{
  "name": "@fern/sdk",
  "version": "0.1.0",
  "description": "Lightweight TypeScript and JSX SDK for Fern desktop plugins",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime.ts",
      "default": "./src/jsx-runtime.ts"
    },
    "./fern.d.ts": "./fern.d.ts"
  },
  "files": [
    "src",
    "fern.d.ts",
    "tsconfig.json",
    "example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:example": "node example/build.mjs"
  },
  "peerDependencies": {
    "esbuild": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
