    }
  },
  {
    "context": "Matrix",
    "bindings": {
      "secondary-backspace": "matrix::DeleteMatrixTask",
      "secondary-delete": "matrix::DeleteMatrixTask"
    }
  },
  {
    "context": "Focus && !TextInput",
    "bindings": {
      "space": "focus::TogglePause"
    }
  },
  {
    "context": "StickyNote",
    "bindings": {
      "f12": "sticky::TogglePin",
      "secondary-shift-c": "sticky::ToggleColor",
      "secondary-e": "sticky::ToggleCollapse",
      "alt-up": "sticky::AlignTop",
      "alt-left": "sticky::AlignLeft",
      "alt-right": "sticky::AlignRight",
      "secondary-alt-p": "fern::PrintDetail"
    }
  },
  {
    "context": "Settings",
    "bindings": {
      "escape": "settings::DismissSettings"
    }
  },
  {
    "context": "TextInput",
    "bindings": {
      "backspace": "text_input::Backspace",
      "delete": "text_input::Delete",
      "ctrl-backspace": "text_input::DeleteWordBackward",
