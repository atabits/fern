#!/usr/bin/env bash
# Builds Fern and its sync server in release mode for a target and packs them into `dist/`:
#   macOS    fern-<version>-macos-<arch>.dmg               Fern.app, drag into Applications
#   Linux    fern-<version>-linux-<arch>.AppImage / .deb / .tar.gz
#   Windows  fern-<version>-windows-<arch>-setup.exe / .zip  installer, or fern.exe to unpack
#   and      fern-server-<version>-<os>-<arch>.tar.gz/.zip the self-hosted sync server
# usage: script/package <rust target triple> [version]
#
# FERN_PREBUILT=1 packs the binaries already in target/<target>/release (signed in between).
# On macOS, with APPLE_SIGNING_IDENTITY (a Developer ID certificate in the keychain) the app is
# signed with it instead of ad hoc, and with APPLE_ID, APPLE_TEAM_ID and APPLE_APP_PASSWORD
# the DMG is notarized by Apple too, so Gatekeeper opens it without a warning.
set -euo pipefail
cd "$(dirname "$0")/.."

target=$1
version=${2:-$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)}
case "$target" in
    aarch64-*) arch=arm64 ;;
    x86_64-*) arch=x86_64 ;;
    *) echo "unsupported target: $target" >&2; exit 1 ;;
esac
case "$target" in
    *-apple-darwin) os=macos ;;
    *-windows-*) os=windows ;;
    *-linux-*) os=linux ;;
esac

if [ -z "${FERN_PREBUILT:-}" ]; then
    cargo build --release --locked --target "$target" -p fern_desktop -p fern_server
fi

bin="target/$target/release"
dist="dist"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$dist"
exe=""
[ "$os" = windows ] && exe=".exe"

# The sync server, for every platform.
server="fern-server-$version-$os-$arch"
mkdir -p "$work/$server"
cp "$bin/fern-server$exe" LICENSE "$work/$server/"
if [ "$os" = windows ]; then
    (cd "$work" && 7z a -tzip "$OLDPWD/$dist/$server.zip" "$server" > /dev/null)
else
    tar -C "$work" -czf "$dist/$server.tar.gz" "$server"
fi

name="fern-$version-$os-$arch"
case "$os" in
    macos)
        app="$work/Fern.app/Contents"
        mkdir -p "$app/MacOS" "$app/Resources"
        cp "$bin/fern" "$app/MacOS/fern"
        iconset="$work/AppIcon.iconset"
        mkdir -p "$iconset"
        for size in 16 32 128 256 512; do
            sips -z "$size" "$size" assets/icon/icon-macos-1024.png --out "$iconset/icon_${size}x${size}.png" > /dev/null
            sips -z $((size * 2)) $((size * 2)) assets/icon/icon-macos-1024.png --out "$iconset/icon_${size}x${size}@2x.png" > /dev/null
        done
        iconutil -c icns "$iconset" -o "$app/Resources/AppIcon.icns"
        cat > "$app/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleName</key><string>Fern</string>
    <key>CFBundleDisplayName</key><string>Fern</string>
    <key>CFBundleIdentifier</key><string>io.github.atabits.fern</string>
    <key>CFBundleExecutable</key><string>fern</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSHumanReadableCopyright</key><string>Fern contributors, AGPL-3.0-or-later</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>Fern task link</string>
            <key>CFBundleURLSchemes</key><array><string>fern</string></array>
        </dict>
    </array>
</dict>
</plist>
EOF
        if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
            # Notarization wants the hardened runtime and a secure timestamp.
            codesign --force --options runtime --timestamp --sign "$APPLE_SIGNING_IDENTITY" "$work/Fern.app"
        else
            # An ad-hoc signature: without one Apple Silicon refuses to run the app at all.
            codesign --force --deep --sign - "$work/Fern.app"
        fi
        mkdir -p "$work/dmg"
        mv "$work/Fern.app" "$work/dmg/"
        ln -s /Applications "$work/dmg/Applications"
        rm -f "$dist/$name.dmg"
        hdiutil create -volname Fern -srcfolder "$work/dmg" -ov -format UDZO "$dist/$name.dmg" > /dev/null
        if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
            codesign --force --timestamp --sign "$APPLE_SIGNING_IDENTITY" "$dist/$name.dmg"
        fi
        if [ -n "${APPLE_SIGNING_IDENTITY:-}" ] && [ -n "${APPLE_ID:-}" ]; then
            xcrun notarytool submit "$dist/$name.dmg" --apple-id "$APPLE_ID" --team-id "$APPLE_TEAM_ID" \
                --password "$APPLE_APP_PASSWORD" --wait
            xcrun stapler staple "$dist/$name.dmg"
        fi
        ;;
    windows)
        mkdir -p "$work/$name"
        cp "$bin/fern.exe" LICENSE README.md "$work/$name/"
        (cd "$work" && 7z a -tzip "$OLDPWD/$dist/$name.zip" "$name" > /dev/null)
        # The installer, with Inno Setup (`choco install innosetup` puts it in Program Files).
        iscc=$(command -v iscc || echo "/c/Program Files (x86)/Inno Setup 6/ISCC.exe")
        # Git Bash would turn the /switches into paths.
        MSYS2_ARG_CONV_EXCL='*' "$iscc" /Q "/DVersion=$version" "/DSourceDir=$(cygpath -w "$PWD/$bin")" \
            "/DOutputDir=$(cygpath -w "$PWD/$dist")" "/DOutputName=$name-setup" assets/windows/fern.iss
        ;;
    linux)
        mkdir -p "$work/$name"
        cp "$bin/fern" assets/linux/fern-tasks.desktop assets/linux/fern.svg LICENSE README.md "$work/$name/"
        tar -C "$work" -czf "$dist/$name.tar.gz" "$name"

        # A .deb for Debian and Ubuntu, where it installs with a double click.
        if command -v dpkg-deb > /dev/null; then
            deb="$work/deb"
            mkdir -p "$deb/DEBIAN" "$deb/usr/bin" "$deb/usr/share/applications" \
                "$deb/usr/share/icons/hicolor/scalable/apps" "$deb/usr/share/doc/fern-tasks"
            cp "$bin/fern" "$deb/usr/bin/fern"
            cp assets/linux/fern-tasks.desktop "$deb/usr/share/applications/"
            cp assets/linux/fern.svg "$deb/usr/share/icons/hicolor/scalable/apps/"
            cp LICENSE "$deb/usr/share/doc/fern-tasks/copyright"
            cat > "$deb/DEBIAN/control" <<EOF
Package: fern-tasks
Version: $version
Architecture: $([ "$arch" = arm64 ] && echo arm64 || echo amd64)
Maintainer: Amin Atabiev <endlessspring.of@gmail.com>
Homepage: https://github.com/atabits/fern
Section: utils
Priority: optional
Depends: libc6, libfontconfig1, libfreetype6, libvulkan1, libwayland-client0, libx11-xcb1, libxcb1, libxkbcommon0, libxkbcommon-x11-0
Description: Tasks, calendar, habits and focus in one native app
 A free, open-source task manager inspired by TickTick. It works offline,
 needs no account and keeps the data on this computer.
EOF
            dpkg-deb -Zxz --root-owner-group --build "$deb" "$dist/$name.deb" > /dev/null
        fi

        appdir="$work/AppDir"
        mkdir -p "$appdir/usr/bin" "$appdir/usr/share/applications" "$appdir/usr/share/icons/hicolor/scalable/apps"
        cp "$bin/fern" "$appdir/usr/bin/fern"
        cp assets/linux/fern-tasks.desktop "$appdir/"
        cp assets/linux/fern-tasks.desktop "$appdir/usr/share/applications/"
        cp assets/linux/fern.svg "$appdir/"
        cp assets/linux/fern.svg "$appdir/usr/share/icons/hicolor/scalable/apps/"
        cat > "$appdir/AppRun" <<'EOF'
#!/bin/sh
here="$(dirname "$(readlink -f "$0")")"
exec "$here/usr/bin/fern" "$@"
EOF
        chmod +x "$appdir/AppRun"
        tool=$(command -v appimagetool || true)
        if [ -z "$tool" ]; then
            appimage_arch=$([ "$arch" = arm64 ] && echo aarch64 || echo x86_64)
            tool="$work/appimagetool"
            curl -fsSL "https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$appimage_arch.AppImage" -o "$tool"
            chmod +x "$tool"
        fi
        # Without FUSE (CI containers) the tool runs from its extracted image.
        APPIMAGE_EXTRACT_AND_RUN=1 ARCH=$([ "$arch" = arm64 ] && echo aarch64 || echo x86_64) \
            "$tool" --no-appstream "$appdir" "$dist/$name.AppImage" > /dev/null
        ;;
esac

ls -lh "$dist"/*"$version-$os-$arch"*
