[
  {
    "bindings": {
      "secondary-q": "fern::Quit",
      "secondary-n": "fern::NewTask",
      "secondary-f": "fern::Search",
      "secondary-\\": "fern::ToggleSidebar",
      "secondary-1": "fern::ShowInbox",
      "secondary-2": "fern::ShowToday",
      "secondary-3": "fern::ShowTomorrow",
      "secondary-4": "fern::ShowNext7Days",
      "secondary-/": "fern::ShowShortcuts",
      "secondary-,": "fern::OpenSettings"
    }
  },
  {
    "context": "TaskList",
    "bindings": {
      "down": "task_list::SelectNext",
      "j": "task_list::SelectNext",
      "up": "task_list::SelectPrevious",
      "k": "task_list::SelectPrevious",
      "space": "task_list::ToggleComplete",
      "delete": "task_list::DeleteTask",
      "backspace": "task_list::DeleteTask",
      "tab m": "task_list::ToggleComplete",
      "tab p": "task_list::PinTask",
      "tab d": "task_list::SetDate",
      "tab 0": "task_list::ClearDate",
      "tab 1": "task_list::SetToday",
      "tab 2": "task_list::SetTomorrow",
      "tab 3": "task_list::SetNextWeek",
      "alt-0": "task_list::PriorityNone",
      "alt-1": "task_list::PriorityLow",
      "alt-2": "task_list::PriorityMedium",
      "alt-3": "task_list::PriorityHigh"
    }
  },
  {
    "context": "Settings",
    "bindings": {
      "escape": "settings::DismissSettings"
    }
  },
  {
    "context": "TextInput",
    "bindings": {
      "backspace": "text_input::Backspace",
      "delete": "text_input::Delete",
      "left": "text_input::Left",
      "right": "text_input::Right",
      "up": "text_input::Up",
      "down": "text_input::Down",
      "shift-left": "text_input::SelectLeft",
      "shift-right": "text_input::SelectRight",
      "shift-up": "text_input::SelectUp",
      "shift-down": "text_input::SelectDown",
      "secondary-a": "text_input::SelectAll",
      "secondary-v": "text_input::Paste",
      "secondary-c": "text_input::Copy",
      "secondary-x": "text_input::Cut",
      "home": "text_input::Home",
      "end": "text_input::End",
      "enter": "text_input::Enter",
      "escape": "text_input::Cancel",
      "ctrl-cmd-space": "text_input::ShowCharacterPalette"
    }
  }
]
