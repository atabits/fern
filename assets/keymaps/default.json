      "secondary-i": "markdown::Italic",
      "secondary-u": "markdown::Underline",
      "secondary-shift-x": "markdown::Strike",
      "secondary-k": "markdown::Link",
      "secondary-alt-c": "markdown::Code",
      "secondary-shift-u": "markdown::Quote"
    }
  },
  {
    "context": "Habits && !TextInput",
    "bindings": {
      "down": "habits::SelectNextHabit",
