[
  {
    "bindings": {
      "secondary-q": "fern::Quit",
      "escape": "fern::DismissTransient"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "secondary-n": "fern::NewTask",
      "secondary-f": "fern::Search",
      "secondary-k": "fern::Search",
      "secondary-s": "fern::SyncNow",
      "secondary-\\": "fern::ToggleSidebar",
      "secondary-1": "fern::ShowInbox",
      "secondary-2": "fern::ShowToday",
      "secondary-3": "fern::ShowTomorrow",
      "secondary-4": "fern::ShowNext7Days",
      "secondary-p": "fern::PrintList",
      "secondary-alt-p": "fern::PrintDetail",
      "secondary-/": "fern::ShowShortcuts",
      "secondary-,": "fern::OpenSettings"
    }
  },
  {
    "context": "Workspace && !TextInput",
    "bindings": {
      "?": "fern::ShowShortcuts",
      "g s": "fern::OpenSettings",
      "g a": "fern::ShowAll",
      "g i": "fern::ShowInbox",
      "g t": "fern::ShowToday",
      "g r": "fern::ShowTomorrow",
      "g n": "fern::ShowNext7Days",
      "g c": "fern::ShowCompleted",
      "g w": "fern::ShowWontDo",
      "g g": "fern::ShowTrash",
      "g h": "fern::GoToHorizons",
      "g u": "fern::GoToSummary"
    }
  },
  {
    "context": "ThingsView && !TextInput",
    "bindings": {
      "s": "things::OpenWhen"
    }
  },
  {
    "context": "TaskList && !TextInput",
    "bindings": {
      "v l": "task_list::ViewList",
      "v k": "task_list::ViewKanban",
      "v t": "task_list::ViewTimeline",
      "down": "task_list::SelectNext",
      "j": "task_list::SelectNext",
      "up": "task_list::SelectPrevious",
      "k": "task_list::SelectPrevious",
      "space": "task_list::ToggleComplete",
      "tab m": "task_list::ToggleComplete",
      "tab p": "task_list::PinTask",
      "tab d": "task_list::SetDate",
      "tab 0": "task_list::ClearDate",
      "tab 1": "task_list::SetToday",
      "tab 2": "task_list::SetTomorrow",
      "tab 3": "task_list::SetNextWeek",
      "tab e": "task_list::ToggleAllSubtasks"
    }
  },
  {
    "context": "TaskList",
    "bindings": {
      "secondary-a": "task_list::SelectAllTasks",
      "shift-down": "task_list::ExtendSelectionNext",
      "shift-up": "task_list::ExtendSelectionPrevious",
      "secondary-backspace": "task_list::DeleteTask",
      "secondary-delete": "task_list::DeleteTask",
      "shift-enter": "task_list::AddSubtask",
      "secondary-z": "task_list::Undo",
      "secondary-shift-z": "task_list::Redo",
      "secondary-y": "task_list::Redo",
      "alt-0": "task_list::PriorityNone",
      "alt-1": "task_list::PriorityLow",
      "alt-2": "task_list::PriorityMedium",
      "alt-3": "task_list::PriorityHigh"
    }
  },
  {
    "context": "Calendar && !TextInput",
    "bindings": {
      "d": "calendar::DayView",
      "1": "calendar::DayView",
      "w": "calendar::WeekView",
      "2": "calendar::WeekView",
      "m": "calendar::MonthView",
      "3": "calendar::MonthView",
      "y": "calendar::YearView",
      "4": "calendar::YearView",
      "a": "calendar::AgendaView",
      "5": "calendar::AgendaView",
      "r": "calendar::MultiDayMode",
      "t": "calendar::CalendarToday",
      "left": "calendar::PreviousPeriod",
      "right": "calendar::NextPeriod"
    }
  },
  {
    "context": "Calendar",
    "bindings": {
      "secondary-n": "fern::NewTask"
    }
  },
  {
    "context": "TaskDraft",
    "bindings": {
      "secondary-enter": "task_detail::SaveDraft"
    }
  },
  {
    "context": "CalendarYear && !TextInput",
    "bindings": {
      "up": "calendar::PreviousYear",
      "left": "calendar::PreviousYear",
      "down": "calendar::NextYear",
      "right": "calendar::NextYear",
      "t": "calendar::CalendarToday"
    }
  },
  {
    "context": "CalendarYear",
    "bindings": {
      "secondary-p": "calendar::PrintYear"
    }
  },
  {
    "context": "SummaryEditor",
    "bindings": {
      "secondary-b": "markdown::Bold",
      "secondary-shift-y": "markdown::Highlight",
      "secondary-shift-s": "markdown::CheckItem",
